* {
  box-sizing: border-box;
}

:root {
  --bg: #f3f7ff;
  --panel: rgba(255, 255, 255, 0.72);
  --panel-strong: #ffffff;
  --surface: #eef4ff;
  --surface-border: rgba(15, 23, 42, 0.08);
  --text: #0f172a;
  --muted: #4b5d79;
  --primary: #2563eb;
  --primary-soft: rgba(37, 99, 235, 0.12);
  --shadow: 0 18px 44px rgba(15, 23, 42, 0.08);
  --radius: 18px;
}

body.dark {
  --bg: #090d18;
  --panel: rgba(15, 23, 42, 0.76);
  --panel-strong: #111827;
  --surface: #0b1220;
  --surface-border: rgba(148, 163, 184, 0.12);
  --text: #e5eefb;
  --muted: #a5b4cf;
  --primary: #60a5fa;
  --primary-soft: rgba(96, 165, 250, 0.14);
  --shadow: 0 20px 52px rgba(2, 6, 23, 0.58);
}

html, body {
  margin: 0;
  min-height: 100%;
  background: var(--bg);
  color: var(--text);
  font-family: Inter, "Segoe UI", sans-serif;
}

body {
  transition: background 0.2s ease, color 0.2s ease;
}

button, input, textarea {
  font: inherit;
}

button {
  appearance: none;
  border: 1px solid var(--surface-border);
  background: var(--panel-strong);
  color: var(--text);
  border-radius: 12px;
  padding: 0.72rem 1rem;
  cursor: pointer;
  transition: transform 0.15s ease, opacity 0.15s ease, border-color 0.15s ease;
}

button:hover {
  transform: translateY(-1px);
}

button.primary {
  background: linear-gradient(135deg, var(--primary), #3790ff);
  border-color: transparent;
  color: white;
}

button.ghost,
button.small-button {
  background: transparent;
}

button.hidden {
  display: none;
}

textarea, input {
  accent-color: var(--primary);
}

.app-shell {
  display: grid;
  grid-template-columns: 295px minmax(0, 1fr) 290px;
  gap: 1rem;
  min-height: 100vh;
  padding: 1rem;
}

.sidebar,
.tools-panel {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.brand-row,
.panel,
.editor-area {
  background: var(--panel);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  backdrop-filter: blur(16px);
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 0.9rem;
  padding: 1rem 1.1rem;
}

.brand-mark {
  width: 2.7rem;
  height: 2.7rem;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--primary), #38bdf8);
  color: white;
  font-size: 1.4rem;
  font-weight: 700;
}

.brand-row h1,
.panel h2 {
  margin: 0;
  font-size: 1rem;
}

.brand-row small,
.setting-row,
.stats-list li,
.snapshot-item small,
.keyboard-panel li,
.slider-wrap,
.search-box,
.note-item small,
.note-item span {
  color: var(--muted);
}

.panel {
  padding: 1rem;
}

.panel-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.8rem;
}

.stats-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 0.7rem;
}

.stats-list li {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.28rem 0;
  border-bottom: 1px solid var(--surface-border);
}

.stats-list li:last-child {
  border-bottom: none;
}

.search-box {
  display: grid;
  gap: 0.5rem;
  margin-bottom: 0.7rem;
}

.search-box input,
#note-title {
  width: 100%;
  border: 1px solid var(--surface-border);
  background: rgba(148, 163, 184, 0.04);
  color: var(--text);
  border-radius: 10px;
  padding: 0.65rem 0.75rem;
  outline: none;
}

.search-box input:focus,
#note-title:focus {
  border-color: rgba(59, 130, 246, 0.45);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
}

.note-list {
  display: grid;
  gap: 0.5rem;
  max-height: 210px;
  overflow: auto;
}

.note-item {
  display: grid;
  gap: 0.18rem;
  width: 100%;
  text-align: left;
  border: 1px solid var(--surface-border);
  border-radius: 10px;
  background: rgba(148, 163, 184, 0.04);
  padding: 0.7rem 0.75rem;
  color: var(--text);
}

.note-item.active {
  border-color: rgba(96, 165, 250, 0.52);
  background: var(--primary-soft);
}

.note-item strong {
  font-size: 0.82rem;
}

.note-item small,
.note-item span {
  font-size: 0.72rem;
  display: block;
  word-break: break-word;
}

.timer-display {
  margin: 0.5rem 0 1rem;
  text-align: center;
  font-size: clamp(1.6rem, 2vw, 2.2rem);
  font-weight: 700;
  letter-spacing: 0.14em;
}

.button-row,
.button-stack,
.topbar-left,
.topbar-right,
.snapshot-actions {
  display: flex;
  gap: 0.5rem;
}

.button-row.compact {
  flex-wrap: wrap;
}

.button-row.compact > * {
  flex: 1;
}

.button-stack {
  flex-direction: column;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 0.8rem;
}

.setting-row input {
  width: 1.1rem;
  height: 1.1rem;
}

.snapshot-list {
  display: grid;
  gap: 0.55rem;
  max-height: 220px;
  overflow: auto;
}

.snapshot-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.7rem;
  padding: 0.7rem 0.75rem;
  border: 1px solid var(--surface-border);
  border-radius: 12px;
  background: rgba(148, 163, 184, 0.04);
}

.snapshot-item.empty {
  display: block;
}

.snapshot-item strong {
  display: block;
  font-size: 0.78rem;
  color: var(--text);
}

.snapshot-actions {
  align-items: center;
}

.editor-area {
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.9rem 1rem;
  border-bottom: 1px solid var(--surface-border);
  background: rgba(148, 163, 184, 0.02);
}

.icon-button {
  width: 2.55rem;
  height: 2.55rem;
  padding: 0;
  display: grid;
  place-items: center;
  border-radius: 10px;
}

.editor-header {
  padding: 0.9rem 1rem 0;
}

#note-title {
  font-size: 1.05rem;
  font-weight: 700;
  border-radius: 12px;
  background: transparent;
}

.editor-wrap {
  flex: 1;
  padding: 1rem;
}

#editor {
  width: 100%;
  min-height: 72vh;
  height: 100%;
  border: 1px solid var(--surface-border);
  background: linear-gradient(180deg, rgba(255,255,255,0.3), rgba(148,163,184,0.03));
  color: var(--text);
  border-radius: 18px;
  padding: 1.2rem 1.1rem;
  resize: none;
  font-size: 1.08rem;
  line-height: 1.8;
  outline: none;
  box-shadow: inset 0 2px 18px rgba(15, 23, 42, 0.05);
}

body.dark #editor {
  background: linear-gradient(180deg, rgba(15,23,42,0.7), rgba(15,23,42,0.32));
  box-shadow: inset 0 2px 18px rgba(2,6,23,0.3);
}

#editor:focus {
  border-color: rgba(59, 130, 246, 0.45);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
}

.ambient-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.5rem;
  margin-bottom: 0.75rem;
}

.ambient-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 2.5rem;
  border: 1px solid var(--surface-border);
  border-radius: 10px;
  background: rgba(148, 163, 184, 0.025);
  color: var(--text);
  font-size: 0.86rem;
}

.ambient-item.active {
  border-color: rgba(96, 165, 250, 0.52);
  background: var(--primary-soft);
}

.slider-wrap {
  display: grid;
  gap: 0.45rem;
}

.slider-wrap input {
  width: 100%;
}

.keyboard-panel ul {
  list-style: none;
  padding-left: 0;
  margin: 0.65rem 0 0;
  display: grid;
  gap: 0.45rem;
}

kbd {
  background: rgba(148, 163, 184, 0.12);
  border: 1px solid var(--surface-border);
  border-bottom-width: 2px;
  border-radius: 6px;
  padding: 0.12rem 0.35rem;
  font-size: 0.8rem;
}

.toast {
  position: fixed;
  right: 1rem;
  bottom: 1rem;
  background: rgba(15, 23, 42, 0.94);
  color: white;
  border-radius: 10px;
  padding: 0.75rem 0.95rem;
  box-shadow: var(--shadow);
  opacity: 0;
  transform: translateY(10px);
  pointer-events: none;
  transition: all 0.2s ease;
}

.toast.show {
  opacity: 1;
  transform: translateY(0);
}

body.focus-mode .sidebar,
body.focus-mode .tools-panel,
body.focus-mode .topbar {
  display: none;
}

body.focus-mode .editor-area {
  grid-column: 1 / -1;
}

body.focus-mode #editor {
  min-height: calc(100vh - 2rem);
}

@media (max-width: 1100px) {
  .app-shell {
    grid-template-columns: 1fr;
  }

  .sidebar,
  .tools-panel {
    order: 2;
  }

  .editor-area {
    order: 1;
  }
}

@media (max-width: 560px) {
  .app-shell {
    padding: 0.75rem;
  }

  .topbar {
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .ambient-list {
    grid-template-columns: 1fr;
  }
}
