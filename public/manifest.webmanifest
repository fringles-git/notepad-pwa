import { jsPDF } from 'jspdf';
import { Document, Packer, Paragraph, TextRun } from 'docx';

const NOTES_KEY = 'notepad-pwa-note';
const SETTINGS_KEY = 'notepad-pwa-settings';
const SNAPSHOTS_KEY = 'notepad-pwa-snapshots';

const editor = document.querySelector('#editor');
const wordCountEl = document.querySelector('#word-count');
const charCountEl = document.querySelector('#char-count');
const paragraphCountEl = document.querySelector('#paragraph-count');
const readingTimeEl = document.querySelector('#reading-time');
const savedStatusEl = document.querySelector('#saved-status');
const saveNoteBtn = document.querySelector('#save-note');
const themeToggle = document.querySelector('#theme-toggle');
const fullscreenBtn = document.querySelector('#fullscreen-btn');
const floatWindowBtn = document.querySelector('#float-window-btn');
const downloadBtn = document.querySelector('#download-btn');
const saveSnapshotBtn = document.querySelector('#save-snapshot');
const snapshotListEl = document.querySelector('#snapshot-list');
const timerDisplayEl = document.querySelector('#timer-display');
const startTimerBtn = document.querySelector('#start-timer');
const pauseTimerBtn = document.querySelector('#pause-timer');
const resetTimerBtn = document.querySelector('#reset-timer');
const breakToggle = document.querySelector('#break-toggle');
const typewriterToggle = document.querySelector('#typewriter-toggle');
const installBtn = document.querySelector('#install-btn');
const ambientListEl = document.querySelector('#ambient-list');
const ambientStopBtn = document.querySelector('#ambient-stop');
const ambientVolumeInput = document.querySelector('#ambient-volume');
const toggleFocusBtn = document.querySelector('#toggle-focus');
const toastEl = document.querySelector('#toast');

let installPromptEvent = null;
let timerInterval = null;
let timerSeconds = 0;
let timerRunning = false;
let breakReminderEnabled = false;
let themeMode = 'dark';
let ambientAudioCtx = null;
let ambientNodes = [];
let ambientName = '';
let clickAudioCtx = null;

const ambientPatterns = [
  'Rain', 'Waves', 'Forest', 'Cafe', 'Fireplace', 'Fan', 'Thunder', 'Night',
  'River', 'Piano', 'Wind', 'Stream', 'Train', 'Campfire', 'Breeze', 'Storm',
  'Chimes', 'Drone', 'Hush', 'Cicadas', 'Desk', 'Moonlight', 'Aurora', 'Meadow', 'Harbor'
];

function showToast(message) {
  toastEl.textContent = message;
  toastEl.classList.add('show');
  clearTimeout(showToast.timeoutId);
  showToast.timeoutId = setTimeout(() => toastEl.classList.remove('show'), 2000);
}

function getDefaultSettings() {
  return {
    darkMode: true,
    breakReminder: false,
    typewriterSound: false,
    lastSaved: new Date().toISOString(),
    ambientSound: '',
    ambientVolume: 45,
    focusMode: false,
  };
}

function readSettings() {
  try {
    const raw = localStorage.getItem(SETTINGS_KEY);
    return raw ? { ...getDefaultSettings(), ...JSON.parse(raw) } : getDefaultSettings();
  } catch {
    return getDefaultSettings();
  }
}

function saveSettings(next) {
  localStorage.setItem(SETTINGS_KEY, JSON.stringify(next));
}

function updateTheme() {
  document.body.classList.toggle('dark', themeMode === 'dark');
  saveSettings({ ...readSettings(), darkMode: themeMode === 'dark' });
}

function updateStats() {
  const text = editor.value;
  const words = text.trim() ? text.trim().split(/\s+/).length : 0;
  const chars = text.length;
  const paragraphs = text ? text.split(/\n\s*\n/).filter(Boolean).length : 0;
  const minutes = Math.max(1, Math.ceil(words / 200));

  wordCountEl.textContent = words.toString();
  charCountEl.textContent = chars.toString();
  paragraphCountEl.textContent = paragraphs.toString();
  readingTimeEl.textContent = `${minutes} min`;
}

function saveCurrentNote() {
  localStorage.setItem(NOTES_KEY, editor.value);
  const timestamp = new Date();
  savedStatusEl.textContent = `Saved ${timestamp.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
  const settings = readSettings();
  settings.lastSaved = timestamp.toISOString();
  saveSettings(settings);
}

function loadCurrentNote() {
  const note = localStorage.getItem(NOTES_KEY) ?? '';
  editor.value = note;
  updateStats();
}

function loadSnapshots() {
  try {
    const raw = JSON.parse(localStorage.getItem(SNAPSHOTS_KEY) ?? '[]');
    return Array.isArray(raw) ? raw : [];
  } catch {
    return [];
  }
}

function persistSnapshots(snapshots) {
  localStorage.setItem(SNAPSHOTS_KEY, JSON.stringify(snapshots));
}

function renderSnapshots() {
  const snapshots = loadSnapshots();
  snapshotListEl.innerHTML = '';

  if (!snapshots.length) {
    snapshotListEl.innerHTML = '<div class="snapshot-item"><div><strong>No snapshots yet</strong><small>Your note versions will appear here.</small></div></div>';
    return;
  }

  snapshots.slice(0, 8).forEach((entry) => {
    const item = document.createElement('div');
    item.className = 'snapshot-item';
    item.innerHTML = `
      <div>
        <strong>${entry.label}</strong>
        <small>${new Date(entry.createdAt).toLocaleString([], { dateStyle: 'short', timeStyle: 'short' })}</small>
      </div>
      <div class="snapshot-actions">
        <button data-restore="${entry.id}" class="small-button">Use</button>
        <button data-delete="${entry.id}" class="small-button ghost">×</button>
      </div>
    `;
    snapshotListEl.appendChild(item);
  });
}

function saveSnapshot() {
  const snapshots = loadSnapshots();
  const timestamp = Date.now();
  const entry = {
    id: `snap-${timestamp}`,
    label: `Snapshot ${snapshots.length + 1}`,
    createdAt: new Date().toISOString(),
    content: editor.value,
  };
  snapshots.unshift(entry);
  persistSnapshots(snapshots.slice(0, 10));
  renderSnapshots();
  showToast('Snapshot saved');
}

function restoreSnapshot(snapshotId) {
  const snapshots = loadSnapshots();
  const selected = snapshots.find((item) => item.id === snapshotId);
  if (!selected) return;
  editor.value = selected.content;
  saveCurrentNote();
  updateStats();
  showToast('Snapshot restored');
}

function deleteSnapshot(snapshotId) {
  const snapshots = loadSnapshots().filter((item) => item.id !== snapshotId);
  persistSnapshots(snapshots);
  renderSnapshots();
}

function formatTimer(totalSeconds) {
  const hours = Math.floor(totalSeconds / 3600).toString().padStart(2, '0');
  const minutes = Math.floor((totalSeconds % 3600) / 60).toString().padStart(2, '0');
  const seconds = (totalSeconds % 60).toString().padStart(2, '0');
  return `${hours}:${minutes}:${seconds}`;
}

function updateTimerDisplay() {
  timerDisplayEl.textContent = formatTimer(timerSeconds);
}

function startTimer() {
  if (timerRunning) return;
  timerRunning = true;
  timerInterval = setInterval(() => {
    timerSeconds += 1;
    updateTimerDisplay();

    if (breakReminderEnabled && timerSeconds > 0 && timerSeconds % 1800 === 0) {
      showToast('Break reminder: stand up, stretch, and breathe.');
    }
  }, 1000);
}

function pauseTimer() {
  timerRunning = false;
  clearInterval(timerInterval);
}

function resetTimer() {
  pauseTimer();
  timerSeconds = 0;
  updateTimerDisplay();
}

function toggleDarkMode() {
  themeMode = themeMode === 'dark' ? 'light' : 'dark';
  updateTheme();
}

function toggleFocusMode() {
  const isFocused = document.body.classList.toggle('focus-mode');
  const settings = readSettings();
  settings.focusMode = isFocused;
  saveSettings(settings);
}

function openFloatingNoteWindow() {
  const newWindow = window.open('', 'notepad-float', 'popup,width=420,height=560');
  if (!newWindow) {
    showToast('Popup blocked. Allow popups for floating mode.');
    return;
  }

  newWindow.document.write(`<!doctype html><html><head><meta charset="utf-8"><title>Notepad Floating</title><style>body{font-family:system-ui,sans-serif;padding:18px;background:#111827;color:#e5eefb;line-height:1.7}textarea{width:100%;height:82vh;resize:none;border-radius:12px;padding:14px;background:#0f172a;color:#fff;border:1px solid rgba(148,163,184,.2)}button{margin-top:12px}</style></head><body><textarea>${escapeHtml(editor.value)}</textarea></body></html>`);
  newWindow.document.close();
}

function escapeHtml(value) {
  return value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

function toggleFullScreen() {
  if (!document.fullscreenElement) {
    document.documentElement.requestFullscreen().catch(() => showToast('Fullscreen is unavailable here.'));
    return;
  }
  document.exitFullscreen();
}

function applySettingsOnLoad() {
  const settings = readSettings();
  themeMode = settings.darkMode ? 'dark' : 'light';
  breakReminderEnabled = settings.breakReminder;
  breakToggle.checked = settings.breakReminder;
  typewriterToggle.checked = settings.typewriterSound;
  ambientVolumeInput.value = String(settings.ambientVolume ?? 45);
  document.body.classList.toggle('focus-mode', Boolean(settings.focusMode));
  updateTheme();
}

function saveNoteWithShortcut(event) {
  if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 's') {
    event.preventDefault();
    saveCurrentNote();
    showToast('Saved locally');
  }

  if ((event.metaKey || event.ctrlKey) && event.shiftKey && event.key.toLowerCase() === 'l') {
    event.preventDefault();
    toggleDarkMode();
  }

  if ((event.metaKey || event.ctrlKey) && event.shiftKey && event.key.toLowerCase() === 'f') {
    event.preventDefault();
    toggleFocusMode();
  }

  if ((event.metaKey || event.ctrlKey) && event.shiftKey && event.key.toLowerCase() === 'd') {
    event.preventDefault();
    exportNote('pdf');
  }
}

function playTypewriterTone() {
  const settings = readSettings();
  if (!settings.typewriterSound) return;

  const AudioCtor = window.AudioContext || window.webkitAudioContext;
  if (!AudioCtor) return;
  const ctx = clickAudioCtx ?? new AudioCtor();
  clickAudioCtx = ctx;
  const oscillator = ctx.createOscillator();
  const gain = ctx.createGain();
  oscillator.type = 'square';
  oscillator.frequency.value = 480;
  gain.gain.value = 0.015;
  oscillator.connect(gain);
  gain.connect(ctx.destination);
  oscillator.start();
  oscillator.stop(ctx.currentTime + 0.03);
}

function createAmbientPreset(name) {
  const baseGain = 0.08;
  return {
    name,
    start() {
      if (ambientAudioCtx === null) {
        const AudioCtor = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtor) return;
        ambientAudioCtx = new AudioCtor();
      }

      const ctx = ambientAudioCtx;
      const master = ctx.createGain();
      master.gain.value = Number(ambientVolumeInput.value) / 100 * 0.14;
      master.connect(ctx.destination);

      if (name === 'Rain') {
        const noise = createNoiseBuffer(ctx, 0.2);
        const source = ctx.createBufferSource();
        source.buffer = noise;
        const filter = ctx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.value = 1200;
        const gain = ctx.createGain();
        gain.gain.value = baseGain;
        source.connect(filter);
        filter.connect(gain);
        gain.connect(master);
        source.loop = true;
        source.start();
        ambientNodes.push({ source, gain, master });
      }

      if (name === 'Ocean' || name === 'Waves') {
        const osc = ctx.createOscillator();
        const lfo = ctx.createOscillator();
        const gain = ctx.createGain();
        const lfoGain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.value = 100;
        lfo.frequency.value = 0.25;
        lfoGain.gain.value = 35;
        lfo.connect(lfoGain);
        lfoGain.connect(osc.frequency);
        gain.gain.value = 0.03;
        osc.connect(gain);
        gain.connect(master);
        osc.start();
        lfo.start();
        ambientNodes.push({ source: osc, gain, master, lfo, lfoGain });
      }

      if (name === 'Forest' || name === 'Meadow') {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.value = 220;
        gain.gain.value = 0.02;
        osc.connect(gain);
        gain.connect(master);
        osc.start();
        ambientNodes.push({ source: osc, gain, master });
      }

      if (name === 'Fireplace' || name === 'Campfire') {
        const noise = createNoiseBuffer(ctx, 0.2);
        const source = ctx.createBufferSource();
        source.buffer = noise;
        const filter = ctx.createBiquadFilter();
        filter.type = 'bandpass';
        filter.frequency.value = 300;
        filter.Q.value = 0.3;
        const gain = ctx.createGain();
        gain.gain.value = 0.025;
        source.connect(filter);
        filter.connect(gain);
        gain.connect(master);
        source.loop = true;
        source.start();
        ambientNodes.push({ source, gain, master });
      }

      if (name === 'Fan' || name === 'Desk') {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.value = 80;
        gain.gain.value = 0.015;
        osc.connect(gain);
        gain.connect(master);
        osc.start();
        ambientNodes.push({ source: osc, gain, master });
      }

      if (name === 'Thunder' || name === 'Storm') {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'square';
        osc.frequency.value = 55;
        gain.gain.value = 0.018;
        osc.connect(gain);
        gain.connect(master);
        osc.start();
        ambientNodes.push({ source: osc, gain, master });
      }

      if (name === 'Piano' || name === 'Moonlight') {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.value = 330;
        gain.gain.value = 0.02;
        osc.connect(gain);
        gain.connect(master);
        osc.start();
        ambientNodes.push({ source: osc, gain, master });
      }

      if (name === 'Breeze' || name === 'Wind' || name === 'Harbor') {
        const noise = createNoiseBuffer(ctx, 0.2);
        const source = ctx.createBufferSource();
        source.buffer = noise;
        const filter = ctx.createBiquadFilter();
        filter.type = 'highpass';
        filter.frequency.value = 220;
        const gain = ctx.createGain();
        gain.gain.value = 0.012;
        source.connect(filter);
        filter.connect(gain);
        gain.connect(master);
        source.loop = true;
        source.start();
        ambientNodes.push({ source, gain, master });
      }

      if (name === 'Night' || name === 'Aurora' || name === 'Hush') {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.value = 180;
        gain.gain.value = 0.015;
        osc.connect(gain);
        gain.connect(master);
        osc.start();
        ambientNodes.push({ source: osc, gain, master });
      }

      if (name === 'River' || name === 'Stream') {
        const noise = createNoiseBuffer(ctx, 0.2);
        const source = ctx.createBufferSource();
        source.buffer = noise;
        const filter = ctx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.value = 600;
        const gain = ctx.createGain();
        gain.gain.value = 0.016;
        source.connect(filter);
        filter.connect(gain);
        gain.connect(master);
        source.loop = true;
        source.start();
        ambientNodes.push({ source, gain, master });
      }

      if (name === 'Train') {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'square';
        osc.frequency.value = 90;
        gain.gain.value = 0.015;
        osc.connect(gain);
        gain.connect(master);
        osc.start();
        ambientNodes.push({ source: osc, gain, master });
      }

      if (name === 'Chimes') {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.value = 740;
        gain.gain.value = 0.018;
        osc.connect(gain);
        gain.connect(master);
        osc.start();
        ambientNodes.push({ source: osc, gain, master });
      }

      if (name === 'Drone') {
        const osc = ctx.createOsculator();
        const gain = ctx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.value = 140;
        gain.gain.value = 0.02;
        osc.connect(gain);
        gain.connect(master);
        osc.start();
        ambientNodes.push({ source: osc, gain, master });
      }
    },
    stop() {
      ambientNodes.forEach(({ source, gain, master, lfo, lfoGain }) => {
        if (source) source.stop();
        if (gain) gain.disconnect();
        if (master) master.disconnect();
        if (lfo) lfo.stop();
        if (lfoGain) lfoGain.disconnect();
      });
      ambientNodes = [];
      if (ambientAudioCtx) {
        ambientAudioCtx.close();
        ambientAudioCtx = null;
      }
    }
  };
}

function createNoiseBuffer(ctx, duration) {
  const buffer = ctx.createBuffer(1, ctx.sampleRate * duration, ctx.sampleRate);
  const output = buffer.getChannelData(0);
  for (let i = 0; i < output.length; i += 1) {
    output[i] = (Math.random() * 2 - 1) * 0.1;
  }
  return buffer;
}

function renderAmbientButtons() {
  ambientListEl.innerHTML = '';
  ambientPatterns.forEach((name) => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = `ambient-item${ambientName === name ? ' active' : ''}`;
    button.textContent = name;
    button.addEventListener('click', () => {
      if (ambientName === name) {
        ambientName = '';
        button.classList.remove('active');
        stopAmbient();
        return;
      }
      ambientName = name;
      renderAmbientButtons();
      startAmbient(name);
    });
    ambientListEl.appendChild(button);
  });
}

function stopAmbient() {
  ambientNodes.forEach(({ source, gain, master, lfo, lfoGain }) => {
    try {
      if (source) source.stop();
    } catch {}
    if (gain) gain.disconnect();
    if (master) master.disconnect();
    if (lfo) lfo.stop();
    if (lfoGain) lfoGain.disconnect();
  });
  ambientNodes = [];
  if (ambientAudioCtx) {
    ambientAudioCtx.close();
    ambientAudioCtx = null;
  }
}

function startAmbient(name) {
  stopAmbient();
  const settings = readSettings();
  settings.ambientSound = name;
  saveSettings(settings);

  const AudioCtor = window.AudioContext || window.webkitAudioContext;
  if (!AudioCtor) {
    showToast('Ambient audio is not supported in this browser.');
    return;
  }

  ambientAudioCtx = new AudioCtor();
  const master = ambientAudioCtx.createGain();
  master.gain.value = Number(ambientVolumeInput.value) / 100 * 0.25;
  master.connect(ambientAudioCtx.destination);

  const noiseBuffer = createNoiseBuffer(ambientAudioCtx, 2);
  const source = ambientAudioCtx.createBufferSource();
  source.buffer = noiseBuffer;
  source.loop = true;

  const filter = ambientAudioCtx.createBiquadFilter();
  filter.type = 'lowpass';
  filter.frequency.value = 800;

  const gain = ambientAudioCtx.createGain();
  gain.gain.value = 0.02;

  source.connect(filter);
  filter.connect(gain);
  gain.connect(master);
  source.start();
  ambientNodes.push({ source, gain, master });

  if (name === 'Rain') {
    filter.frequency.value = 1000;
    gain.gain.value = 0.025;
  }
  if (name === 'Forest') {
    const osc = ambientAudioCtx.createOscillator();
    osc.type = 'triangle';
    osc.frequency.value = 180;
    const oscGain = ambientAudioCtx.createGain();
    oscGain.gain.value = 0.018;
    osc.connect(oscGain);
    oscGain.connect(master);
    osc.start();
    ambientNodes.push({ source: osc, gain: oscGain, master });
  }
  if (name === 'Fan') {
    const osc = ambientAudioCtx.createOscillator();
    osc.type = 'sawtooth';
    osc.frequency.value = 70;
    const oscGain = ambientAudioCtx.createGain();
    oscGain.gain.value = 0.015;
    osc.connect(oscGain);
    oscGain.connect(master);
    osc.start();
    ambientNodes.push({ source: osc, gain: oscGain, master });
  }
  if (name === 'Ocean' || name === 'Waves') {
    const osc = ambientAudioCtx.createOscillator();
    osc.type = 'sine';
    osc.frequency.value = 90;
    const oscGain = ambientAudioCtx.createGain();
    oscGain.gain.value = 0.02;
    osc.connect(oscGain);
    oscGain.connect(master);
    osc.start();
    ambientNodes.push({ source: osc, gain: oscGain, master });
  }
  if (name === 'Thunder' || name === 'Storm') {
    const osc = ambientAudioCtx.createOscillator();
    osc.type = 'square';
    osc.frequency.value = 60;
    const oscGain = ambientAudioCtx.createGain();
    oscGain.gain.value = 0.022;
    osc.connect(oscGain);
    oscGain.connect(master);
    osc.start();
    ambientNodes.push({ source: osc, gain: oscGain, master });
  }
}

function exportNote(format = 'txt') {
  const text = editor.value || 'Start writing...';

  if (format === 'txt') {
    const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
    downloadBlob(blob, 'note.txt');
    showToast('TXT exported');
    return;
  }

  if (format === 'html') {
    const html = `<!doctype html><html><head><meta charset="utf-8"><title>Note</title></head><body>${text.replace(/\n/g, '<br>')}</body></html>`;
    const blob = new Blob([html], { type: 'text/html;charset=utf-8' });
    downloadBlob(blob, 'note.html');
    showToast('HTML exported');
    return;
  }

  if (format === 'pdf') {
    const pdf = new jsPDF();
    const lines = pdf.splitTextToSize(text || 'Start writing...', 180);
    pdf.text(lines, 14, 20);
    pdf.save('note.pdf');
    showToast('PDF exported');
    return;
  }

  if (format === 'docx') {
    const doc = new Document({
      sections: [{
        children: [
          new Paragraph({
            children: [new TextRun({ text: text || 'Start writing...', break: 1 })]
          })
        ]
      }]
    });

    Packer.toBlob(doc).then((blob) => {
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'note.docx';
      a.click();
      URL.revokeObjectURL(url);
      showToast('DOCX exported');
    });
  }
}

function downloadBlob(blob, filename) {
  const url = URL.createObjectURL(blob);
  const anchor = document.createElement('a');
  anchor.href = url;
  anchor.download = filename;
  anchor.click();
  URL.revokeObjectURL(url);
}

function bindEvents() {
  editor.addEventListener('input', () => {
    updateStats();
    saveCurrentNote();
  });

  editor.addEventListener('keydown', (event) => {
    saveNoteWithShortcut(event);
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'b') {
      event.preventDefault();
      toggleDarkMode();
    }
    if (readSettings().typewriterSound) {
      const allowed = ['Backspace', 'Enter', ' ', 'Tab'];
      if (event.key.length === 1 || allowed.includes(event.key)) {
        playTypewriterTone();
      }
    }
  });

  saveNoteBtn.addEventListener('click', saveCurrentNote);
  themeToggle.addEventListener('click', toggleDarkMode);
  fullscreenBtn.addEventListener('click', toggleFullScreen);
  floatWindowBtn.addEventListener('click', openFloatingNoteWindow);
  toggleFocusBtn.addEventListener('click', toggleFocusMode);
  downloadBtn.addEventListener('click', () => exportNote('pdf'));
  document.querySelector('#export-text').addEventListener('click', () => exportNote('txt'));
  document.querySelector('#export-html').addEventListener('click', () => exportNote('html'));
  document.querySelector('#export-pdf').addEventListener('click', () => exportNote('pdf'));
  document.querySelector('#export-docx').addEventListener('click', () => exportNote('docx'));

  saveSnapshotBtn.addEventListener('click', saveSnapshot);
  snapshotListEl.addEventListener('click', (event) => {
    const restoreTarget = event.target.closest('[data-restore]');
    const deleteTarget = event.target.closest('[data-delete]');
    if (restoreTarget) restoreSnapshot(restoreTarget.dataset.restore);
    if (deleteTarget) deleteSnapshot(deleteTarget.dataset.delete);
  });

  startTimerBtn.addEventListener('click', startTimer);
  pauseTimerBtn.addEventListener('click', pauseTimer);
  resetTimerBtn.addEventListener('click', resetTimer);

  breakToggle.addEventListener('change', () => {
    breakReminderEnabled = breakToggle.checked;
    const settings = readSettings();
    settings.breakReminder = breakReminderEnabled;
    saveSettings(settings);
    showToast(breakReminderEnabled ? 'Break reminders on' : 'Break reminders off');
  });

  typewriterToggle.addEventListener('change', () => {
    const settings = readSettings();
    settings.typewriterSound = typewriterToggle.checked;
    saveSettings(settings);
    showToast(settings.typewriterSound ? 'Typewriter sound on' : 'Typewriter sound off');
  });

  ambientVolumeInput.addEventListener('input', () => {
    const settings = readSettings();
    settings.ambientVolume = Number(ambientVolumeInput.value);
    saveSettings(settings);
    if (ambientName) {
      startAmbient(ambientName);
    }
  });

  ambientStopBtn.addEventListener('click', () => {
    ambientName = '';
    stopAmbient();
    renderAmbientButtons();
  });

  window.addEventListener('beforeinstallprompt', (event) => {
    event.preventDefault();
    installPromptEvent = event;
    installBtn.classList.remove('hidden');
  });

  installBtn.addEventListener('click', async () => {
    if (!installPromptEvent) return;
    installPromptEvent.prompt();
    await installPromptEvent.userChoice;
    installBtn.classList.add('hidden');
  });

  window.addEventListener('keydown', saveNoteWithShortcut);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') saveCurrentNote();
  });
}

function bootstrap() {
  loadCurrentNote();
  renderSnapshots();
  updateTimerDisplay();
  applySettingsOnLoad();
  renderAmbientButtons();
  bindEvents();
  if (readSettings().ambientSound) {
    ambientName = readSettings().ambientSound;
    startAmbient(ambientName);
  }
}

bootstrap();

if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('/sw.js').catch(() => {});
  });
}
